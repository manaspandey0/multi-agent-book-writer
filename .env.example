# Copy this file to .env and fill in your own values. Never commit .env.

# "groq" for real generation, "mock" for offline demos and tests (no key needed).
LLM_PROVIDER=groq

# Create a key at https://console.groq.com/keys
GROQ_API_KEY="your-groq-api-key-here"

# Pick a current model that supports JSON mode from
# https://console.groq.com/docs/models  (model availability changes over time)
GROQ_MODEL=your-chosen-groq-model-id

# Optional tuning (defaults shown)
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2
# LLM_MAX_COMPLETION_TOKENS=3000
# LLM_TOKENS_PER_MINUTE_LIMIT=8000   (your Groq tier limit; completion budget is shrunk to fit)
# GROQ_REASONING_EFFORT=low   (gpt-oss models only; low|medium|high)
# LLM_MAX_RATE_LIMIT_WAIT_SECONDS=65
# MAX_REVISION_ROUNDS=2
# MAX_SOURCES_PER_CHAPTER=6
# PER_DOMAIN_DELAY_SECONDS=1.5
# LOG_LEVEL=INFO
